# Copy to server/.env and fill in. Comments go on their own line: text after a value is part of the value. Every setting is checked at startup (src/config/env.ts).
NODE_ENV=development
PORT=8080
# debug | info | warn | error. Debug logs AI prompts: never in production.
LOG_LEVEL=info

# SQL Server (see docs/DECISIONS.md: SQL Server, not Postgres). docker compose starts one on 1433.
DATABASE_URL=mssql://sa:Change_me_123@localhost:1433/taskplus?trustServerCertificate=true
REDIS_URL=redis://localhost:6379

# --- prototype vs production switches (spec §12) ---
# inline (prototype) | bullmq (production, needs Redis + npm run worker)
QUEUE_MODE=inline
# memory (one API copy) | redis (several copies behind a load balancer)
REALTIME_MODE=memory
# gemini | groq | ollama
LLM_PRIMARY=gemini
# groq | ollama | none
LLM_FALLBACK=groq
LLM_TIMEOUT_MS=12000
JOB_MAX_ATTEMPTS=3

# --- providers (only checked when that provider is used) ---
# Free tiers may use content for training: use made-up customer data until a paid tier is set up.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# a current "gemini-*-flash" model id
GEMINI_MODEL=
# https://console.groq.com/keys
GROQ_API_KEY=
# a current Groq chat model id (fallback LLM)
GROQ_LLM_MODEL=
GROQ_STT_MODEL=whisper-large-v3-turbo
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Cloudflare dashboard > R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=taskplus
PRESIGN_TTL_SECONDS=300

# base64 of the Firebase service-account JSON
FIREBASE_SERVICE_ACCOUNT_JSON=

# at least 32 random characters, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# dev only: starting password for seeded people (npm run seed). The server refuses to start in production if set.
SEED_PASSWORD=Taskplus@2026
# true when running behind a load balancer / reverse proxy
TRUST_PROXY=false

# --- business rules ---
DEFAULT_PRIORITY=Medium
SLA_HOURS_HIGH=4
SLA_HOURS_MEDIUM=24
SLA_HOURS_LOW=72
# optional, e.g. ^[A-Z0-9-]{6,20}$ ; licence numbers that don't match are dropped with a warning
LICENSE_REGEX=
