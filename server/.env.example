# Copy to server/.env and fill in. Every setting is checked at startup (src/config/env.ts).
NODE_ENV=development
PORT=8080
LOG_LEVEL=info                 # debug | info | warn | error. Debug logs AI prompts: never in production.

# SQL Server (see docs/DECISIONS.md: SQL Server, not Postgres). docker compose starts one on 1433.
DATABASE_URL=mssql://sa:Change_me_123@localhost:1433/taskplus?trustServerCertificate=true
REDIS_URL=redis://localhost:6379

# --- prototype vs production switches (spec §12) ---
QUEUE_MODE=inline              # inline (prototype) | bullmq (production, needs Redis + npm run worker)
REALTIME_MODE=memory           # memory (one API copy) | redis (several copies behind a load balancer)
LLM_PRIMARY=gemini             # gemini | groq | ollama
LLM_FALLBACK=groq              # groq | ollama | none
LLM_TIMEOUT_MS=12000
JOB_MAX_ATTEMPTS=3

# --- providers (only checked when that provider is used) ---
# Free tiers may use content for training: use made-up customer data until a paid tier is set up.
GEMINI_API_KEY=                # https://aistudio.google.com/apikey
GEMINI_MODEL=                  # a current "gemini-*-flash" model id
GROQ_API_KEY=                  # https://console.groq.com/keys
GROQ_LLM_MODEL=                # a current Groq chat model id (fallback LLM)
GROQ_STT_MODEL=whisper-large-v3-turbo
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

R2_ACCOUNT_ID=                 # Cloudflare dashboard > R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=taskplus
PRESIGN_TTL_SECONDS=300

FIREBASE_SERVICE_ACCOUNT_JSON= # base64 of the Firebase service-account JSON

JWT_SECRET=                    # at least 32 random characters, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
DEV_FIXED_OTP=123456           # dev only; the server refuses to start in production if this is set
TRUST_PROXY=false              # true when running behind a load balancer / reverse proxy

# --- business rules ---
DEFAULT_PRIORITY=Medium
SLA_HOURS_HIGH=4
SLA_HOURS_MEDIUM=24
SLA_HOURS_LOW=72
LICENSE_REGEX=                 # optional, e.g. ^[A-Z0-9-]{6,20}$ ; licence numbers that don't match are dropped with a warning
