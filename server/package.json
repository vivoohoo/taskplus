    "pino": "^10.4.0",
    "tarn": "^3.1.2",
    "tedious": "^19.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/mssqlserver": "^12.2.2",
    "@types/node": "^20.19.43",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^3.2.7",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "testcontainers": "^12.2.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
